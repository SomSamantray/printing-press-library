{
  "manifest_version": "0.3",
  "name": "notebooklm-pp-cli",
  "display_name": "Gemini Notebook (NotebookLM)",
  "version": "0.2.0",
  "description": "Unofficial Go CLI and agent surface for Gemini Notebook — notebooks, sources, chat, Studio artifacts, and research via batchexecute RPC with Chrome session auth.",
  "author": {
    "name": "CLI Printing Press"
  },
  "license": "Apache-2.0",
  "server": {
    "type": "binary",
    "entry_point": "bin/notebooklm-pp-cli",
    "mcp_config": {
      "command": "${__dirname}/bin/notebooklm-pp-cli",
      "args": ["mcp", "stdio"]
    }
  },
  "compatibility": {
    "claude_desktop": ">=1.0.0",
    "platforms": ["darwin", "linux", "win32"]
  }
}
